{
  "name": "vide-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Vide AI — Video Intelligence. Transforme vídeos em texto, conhecimento e conteúdo pronto para publicar.",
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "services:reset": "docker compose down -v"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "nuxt": "4.5.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "vue-tsc": "2.2.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1124.0",
    "@nuxt/fonts": "0.14.0",
    "drizzle-orm": "0.45.2",
    "ioredis": "6.0.0",
    "postgres": "3.4.9",
    "zod": "4.5.4"
  }
}
