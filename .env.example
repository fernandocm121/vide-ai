# Copie para .env  ->  cp .env.example .env
# Os valores padrão batem com o docker-compose.yml (dev local).

# ─── App ───────────────────────────────────────────────────────────
NODE_ENV=development
# URL pública (canonical). Em produção: o domínio real (ex.: https://videai.app).
# Alimenta sitemap.xml, robots.txt, tags canônicas e imagens OG.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Analytics de produto — PostHog ───────────────────────────────
# Sem a key o tracking vira no-op (dev/preview). Pegue em app.posthog.com.
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── PostgreSQL ────────────────────────────────────────────────────
DATABASE_URL=postgresql://videai:videai@localhost:5432/videai

# ─── Redis (fila BullMQ — Fase 4) ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Object storage (S3-compatível) ───────────────────────────────
# Local: MinIO (docker-compose). Produção: Cloudflare R2 / AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=videai-media
S3_ACCESS_KEY_ID=videai
S3_SECRET_ACCESS_KEY=videai_secret
S3_FORCE_PATH_STYLE=true

# ─── Upload ───────────────────────────────────────────────────────
# Áudio (MP3/WAV) — 25 MB, limite da API de transcrição da OpenAI
MAX_UPLOAD_BYTES=26214400
# Vídeo (MP4/MOV/WEBM) — 2 GB
MAX_VIDEO_UPLOAD_BYTES=2147483648

# ─── Transcrição — OpenAI Whisper (Fase 3) ────────────────────────
OPENAI_API_KEY=sk-proj-REPLACE_ME

# ─── Limites de plano ──────────────────────────────────────────────
# Plano free: minutos de transcrição por mês (1800s = 30 min)
FREE_PLAN_MONTHLY_SECONDS=1800

# ─── Integrações de IA (Fase 6+) ──────────────────────────────────
# ANTHROPIC_API_KEY=

# ─── E-mail transacional ───────────────────────────────────────────
# Confirmação de conta e redefinição de senha. Sem nenhum provedor
# configurado abaixo, os e-mails só ficam no log do servidor (dev).
#
# Opção 1 — SMTP (ex.: Gmail). Tem prioridade sobre o Resend quando
# configurado, e entrega pra qualquer destinatário sem precisar verificar
# domínio. Gere uma "senha de app" em myaccount.google.com/apppasswords
# (exige verificação em duas etapas ativada na conta).
# Não funciona com contas que têm o Programa de Proteção Avançada do Google
# ativado (myaccount.google.com/advanced-protection) — ele bloqueia senha de
# app pra SMTP de terceiros por design, mesmo com a senha "ativa" na lista.
# Use uma conta sem Proteção Avançada, ou pule pra opção 2 (Resend).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Opção 2 — Resend. Pegue a key em resend.com/api-keys. Sem domínio próprio
# verificado em resend.com/domains, só entrega pro e-mail dono da conta —
# use como alternativa ao SMTP quando já tiver um domínio.
RESEND_API_KEY=
# Remetente usado pelo Resend (o SMTP usa sempre o próprio SMTP_USER).
MAIL_FROM=Vide AI <onboarding@resend.dev>

# ─── Login com Google (OAuth 2.0) ──────────────────────────────────
# Sem as duas, o botão "Continuar com Google" fica desativado (mostra um
# aviso e cai pro login com e-mail/senha).
#
# 1. console.cloud.google.com/apis/credentials — crie um projeto (ou use um
#    existente) e configure a "Tela de consentimento OAuth" (tipo Externo
#    serve pra testar; adicione seu e-mail em "Test users" se ficar em modo
#    de teste).
# 2. Criar credenciais → ID do cliente OAuth → tipo "Aplicativo da Web".
# 3. Em "URIs de redirecionamento autorizados", adicione EXATAMENTE:
#    ${NUXT_PUBLIC_SITE_URL}/api/auth/google/callback
#    (em dev: http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
