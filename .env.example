# Copie para .env  ->  cp .env.example .env
# Os valores padrão batem com o docker-compose.yml (dev local).

# ─── App ───────────────────────────────────────────────────────────
NODE_ENV=development
# URL pública (canonical). Em produção: o domínio real (ex.: https://videai.app).
# Alimenta sitemap.xml, robots.txt, tags canônicas e imagens OG.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Analytics de produto — PostHog ───────────────────────────────
# Sem a key o tracking vira no-op (dev/preview). Pegue em app.posthog.com.
NUXT_PUBLIC_POSTHOG_KEY=
NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── PostgreSQL ────────────────────────────────────────────────────
DATABASE_URL=postgresql://videai:videai@localhost:5432/videai

# ─── Redis (fila BullMQ — Fase 4) ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Object storage (S3-compatível) ───────────────────────────────
# Local: MinIO (docker-compose). Produção: Cloudflare R2 / AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=videai-media
S3_ACCESS_KEY_ID=videai
S3_SECRET_ACCESS_KEY=videai_secret
S3_FORCE_PATH_STYLE=true

# ─── Upload ───────────────────────────────────────────────────────
# 25 MB — limite da API de transcrição da OpenAI
MAX_UPLOAD_BYTES=26214400

# ─── Transcrição — OpenAI Whisper (Fase 3) ────────────────────────
OPENAI_API_KEY=sk-proj-REPLACE_ME

# ─── Integrações de IA (Fase 6+) ──────────────────────────────────
# ANTHROPIC_API_KEY=
